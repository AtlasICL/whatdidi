#!/bin/sh
# Install whatdidi. Two supported invocations:
#   1) Remote one-liner: curl -fsSL .../install | sh
#      (downloads the whatdidi script from the repo automatically)
#   2) From a clone: ./install
#      (installs the whatdidi file sitting next to this script)
set -eu

# ---- Helper functions --------------------------------------------------------
# Only emit ANSI color escapes when stdout is an interactive terminal. Under the
# primary documented usage (`curl ... | sh`) or when the output is redirected to
# a file/log, stdout is not a tty and the raw escapes would appear as literal
# garbage — so blank the color vars in that case.
if [ -t 1 ]; then
  BLUE="\033[94m"
  BACKGROUND_NAVY="\033[48;5;19m"
  GREEN="\033[92m"
  ORANGE="\033[38;5;208m"
  PURPLE="\033[35m"
  RED="\033[31m"
  RESET="\033[0m"
else
  BLUE=""
  BACKGROUND_NAVY=""
  GREEN=""
  ORANGE=""
  PURPLE=""
  RED=""
  RESET=""
fi

print_info() { printf "\n${BLUE}[INFO] %s${RESET}\n" "$*"; }
print_success() { printf "\n${GREEN}[OK] %s${RESET}\n" "$*"; }
print_warning() { printf "\n${ORANGE}[WARNING] %s${RESET}\n" "$*"; }
print_error() { printf "\n${RED}[ERROR] %s${RESET}\n" "$*"; }
# ------------------------------------------------------------------------------

REPO_RAW="https://raw.githubusercontent.com/AtlasICL/whatdidi/main"
INSTALL_PATH="/usr/local/bin/whatdidi"
SOURCE_LINE="source /usr/local/bin/whatdidi"

# Prefer a whatdidi file sitting next to this script (clone/dev installs);
# otherwise download it from the repo. This lets the same script run both from a
# clone and via `curl ... | sh`, where there is no sibling file on disk.
script_dir=""
case "$0" in
    */*) script_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" ;;
esac

if ! sudo -v 2>/dev/null; then
  print_error "Installation requires sudo privileges."
  exit 1
fi

print_info "Installing whatdidi to $INSTALL_PATH ..."
if [ -n "$script_dir" ] && [ -f "$script_dir/whatdidi" ]; then
    print_info "Using local copy: $script_dir/whatdidi"
    sudo cp "$script_dir/whatdidi" "$INSTALL_PATH"
else
    if ! command -v curl >/dev/null 2>&1; then
        print_error "curl is required to download whatdidi but was not found."
        exit 1
    fi
    print_info "Downloading whatdidi from $REPO_RAW/whatdidi ..."
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT INT TERM
    if ! curl -fsSL "$REPO_RAW/whatdidi" -o "$tmp"; then
        print_error "Failed to download whatdidi from $REPO_RAW/whatdidi"
        exit 1
    fi
    sudo cp "$tmp" "$INSTALL_PATH"
fi
sudo chmod 644 "$INSTALL_PATH"

# Add the source line to a shell rc file only if not already present - idempotent.
# Appending creates the file if it does not exist yet.
add_source_line() {
    rc="$1"
    # Only touch rc files the user already has — don't create e.g. a ~/.zshrc
    # for someone who doesn't use zsh.
    if [ ! -f "$rc" ]; then
        print_info "$rc does not exist - skipping"
        return 0
    fi
    if ! grep -qxF "$SOURCE_LINE" "$rc" 2>/dev/null; then
        echo "" >> "$rc"
        echo "$SOURCE_LINE" >> "$rc"
        print_info "Added source line to $rc"
    else
        print_info "$rc already sources whatdidi - skipping"
    fi
    rc_written=1
}

# whatdidi works in both bash and zsh - wire it into whichever rc files exist.
add_source_line "$HOME/.bashrc"
add_source_line "$HOME/.zshrc"

# If the user had neither rc file, whatdidi wouldn't be sourced anywhere;
# create ~/.bashrc (the common default) so the tool works out of the box.
if [ -z "${rc_written:-}" ]; then
    print_warning "Neither ~/.bashrc nor ~/.zshrc exists; creating ~/.bashrc"
    printf '\n%s\n' "$SOURCE_LINE" >> "$HOME/.bashrc"
    print_info "Added source line to $HOME/.bashrc"
fi

print_success "Done! Restart your terminal to use whatdidi"
