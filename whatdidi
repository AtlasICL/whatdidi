# Install: 1) add this file to /usr/local/bin/whatdidi
#          2) add `source /usr/local/bin/whatdidi` to ~/.bashrc and/or ~/.zshrc

whatdidi() {
  local needle count line default_count _wdi_conf _wdi_line
  _wdi_conf="${HOME}/.config/whatdidi/config"
  default_count=1
  if [[ -f "$_wdi_conf" ]]; then
    while IFS= read -r _wdi_line || [[ -n "$_wdi_line" ]]; do
      [[ "$_wdi_line" == default_count=* ]] && default_count="${_wdi_line#default_count=}"
    done < "$_wdi_conf"
  fi
  needle="${1:-}"
  count="${2:-$default_count}"

  if [[ "$needle" == "--version" || "$needle" == "-v" ]]; then
    echo "whatdidi 1.1.0"
    echo "Author: Emre Acarsoy"
    return 0
  fi

  if [[ "$needle" == "--help" || "$needle" == "-h" ]]; then
    cat <<'HELP'
Usage:
  whatdidi <command> [count]

Arguments:
  command   The command name to search for in your shell history.
            Use quotes for multi-word commands (e.g. "git push").
  count     Number of recent matches to show (default: 1).

Options:
  --set-default <n>   Set the default number of results to show
                      when count is not specified. Persists across
                      sessions (~/.config/whatdidi/config).
  --update            Reinstall whatdidi with the latest version
                      from the repository.
  -v, --version       Show version and author information.
  -h, --help          Show this help message.

Examples:
  whatdidi curl                # last curl command you ran
  whatdidi mvn 3               # last 3 mvn commands
  whatdidi "git push" 2        # last 2 git push commands
  whatdidi --set-default 5     # always show 5 results by default

Commands prefixed with sudo are matched automatically.
HELP
    return 0
  fi

  if [[ "$needle" == "--update" ]]; then
    if ! command -v curl >/dev/null 2>&1; then
      echo "whatdidi: curl is required to update but was not found" >&2
      return 1
    fi
    echo "whatdidi: fetching the latest version ..."
    curl -fsSL https://raw.githubusercontent.com/AtlasICL/whatdidi/main/install | sh
    return $?
  fi

  if [[ "$needle" == "--set-default" ]]; then
    local new_count="${2:-}"
    if [[ -z "$new_count" ]] || ! [[ "$new_count" =~ ^[0-9]+$ ]] || [[ "$new_count" -lt 1 ]]; then
      echo "whatdidi: --set-default requires a nonzero positive int" >&2
      return 2
    fi
    mkdir -p "${HOME}/.config/whatdidi"
    printf 'default_count=%s\n' "$new_count" > "$_wdi_conf"
    echo "whatdidi: default count set to $new_count"
    return 0
  fi

  if [[ -z "$needle" || $# -gt 2 ]]; then
    echo "Usage: whatdidi <command> [count]  (try --help)" >&2
    return 2
  fi
  if ! [[ "$count" =~ ^[0-9]+$ ]] || [[ "$count" -lt 1 ]]; then
    echo "whatdidi: count must be a nonzero positive int" >&2
    return 2
  fi

  # Refresh session history so the search sees the latest commands (bash only;
  # zsh keeps the interactive history in memory already).
  if [ -z "${ZSH_VERSION:-}" ]; then
    builtin history -a 2>/dev/null || true
    builtin history -n 2>/dev/null || true
  fi

  # Walk history from most-recent to oldest and print the first N matches.
  # Both shells emit "<number>  <command>"; the sed strips the leading number.
  {
    if [ -n "${ZSH_VERSION:-}" ]; then
      builtin fc -rl 1            # zsh: reverse-list ALL events (1 = from start)
    else
      builtin history | tac       # bash: full in-memory list, newest first
    fi
  } | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' | \
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$needle" != whatdidi* && "$line" == whatdidi\ * ]] && continue

    if [[ "$line" =~ ^[[:space:]]*(${needle})([[:space:]]|$) ]] || \
       [[ "$line" =~ ^[[:space:]]*sudo[[:space:]]+(${needle})([[:space:]]|$) ]]; then
      printf '%s\n' "$line"
      count=$((count-1))
      [[ "$count" -le 0 ]] && break
    fi
  done

  # The while loop's exit status leaks the last iteration's test result, which
  # differs between bash and zsh. Return success explicitly so the exit code is
  # deterministic (whatdidi reports 0 whether or not anything matched).
  return 0
}